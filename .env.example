# 登录账号
USERNAME=admin
PASSWORD=admin
# chainlit 2.x 需要 JWT secret（运行 chainlit create-secret 或填入随机字符串）
CHAINLIT_AUTH_SECRET=your_secret_here

# 数据库配置(需要与下面pg服务的配置一致)
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=audio_notes
POSTGRES_HOST=127.0.0.1
# Provider 配置
# 云端模式: ASR_PROVIDER=groq, LLM_PROVIDER=groq
# 本地模式: ASR_PROVIDER=funasr, LLM_PROVIDER=ollama
ASR_PROVIDER=groq
LLM_PROVIDER=groq

# Docker 宿主机端口
WEBUI_HOST_PORT=15433
POSTGRES_HOST_PORT=15432

# Groq 配置（在 https://console.groq.com/keys 获取 API Key）
GROQ_API_KEY=your_groq_api_key_here

# ASR 配置（Groq Whisper）
# 可选模型: whisper-large-v3, whisper-large-v3-turbo, distil-whisper-large-v3-en
GROQ_WHISPER_MODEL=whisper-large-v3
# 音频语言，zh=中文，en=英文，留空则自动检测
GROQ_WHISPER_LANGUAGE=zh

# LLM 配置（Groq Chat）
# 可选模型: qwen/qwen3-32b, llama-3.3-70b-versatile, llama3-8b-8192, mixtral-8x7b-32768
GROQ_LLM_MODEL=qwen/qwen3-32b

# Ollama 配置（本地模式使用）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_API_KEY=ollama
